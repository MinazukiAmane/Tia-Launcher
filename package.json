{
  "name": "tia-launcher-tauri",
  "version": "2.1.1",
  "private": true,
  "description": "Tia Launcher - cross-platform game launcher",
  "author": {
    "name": "Serenetia",
    "email": "amane@serenetia.com"
  },
  "homepage": "https://cso-rse.my.id",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc --noEmit -p tsconfig.web.json && vite build --config vite.config.ts",
    "tauri": "tauri",
    "build:native": "tauri build --no-bundle",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "build:bridge": "tsc --noEmit -p tsconfig.node.json && electron-vite build"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.4",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.1",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "temp": "file:migration/compat/temp",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.4",
    "zod": "^4.6.6",
    "@electron/asar": "^4.3.1",
    "@electron/get": "^5.1.0",
    "lodash.isequal": "npm:fast-deep-equal@^3.1.3",
    "temp": "$temp",
    "glob@>=9 <=14.0.1": "^14.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": false
  }
}
