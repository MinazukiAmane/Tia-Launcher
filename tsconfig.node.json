{
  "include": [
    "electron.vite.config.ts",
    "migration/electron/**/*",
    "src/shared/**/*",
    "migration/installer/identity.json"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "node"
    ],
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
