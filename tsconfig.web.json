{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/launcherLanguages.json"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ]
    }
  }
}
